# SC26 requires embedded scalable fonts in every submitted figure.
# Liberation Serif is the preferred Times-compatible paper font. DejaVu Serif
# ships with Matplotlib and is the offline fallback when Liberation Serif is
# unavailable. Type 42 embeds either TrueType face in PDF/PS output instead of
# Matplotlib's non-compliant Type 3 glyphs.
font.family: serif
font.serif: Liberation Serif, DejaVu Serif
mathtext.fontset: dejavuserif
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
axes.unicode_minus: False
